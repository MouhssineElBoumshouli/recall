# Server-only secret. Never expose this with an EXPO_PUBLIC_ prefix.
GEMINI_API_KEY=

# Local token server
TOKEN_SERVER_PORT=8787

# Mobile app token endpoint. Use 10.0.2.2 for the Android emulator,
# 127.0.0.1 for the iOS simulator, or your computer's LAN IP on a device.
EXPO_PUBLIC_TOKEN_SERVER_URL=http://10.0.2.2:8787

# Optional Phase 0.6 Google Cloud Speech-to-Text V2 adapter (server only).
# Leave blank until Cloud Speech-to-Text is enabled and ADC is configured.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_SPEECH_LOCATION=us
# Optional when using a service-account ADC file. Never commit that file.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional Phase 0.6 experiment. Keep false until A, B, and C are benchmarked independently.
RECALL_ENABLE_RECONCILIATION=false
